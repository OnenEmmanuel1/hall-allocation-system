<%- include('../partials/header') %>

<div class="ehas-app">
  <%- include('../partials/sidebar-admin') %>

  <div class="ehas-main-wrapper">
    <%- include('../partials/topbar') %>

    <main class="ehas-content">
      
      <!-- Page Header -->
      <div class="ehas-page-header">
        <div>
          <h1 class="ehas-page-title">Manage Examination Halls</h1>
          <p class="ehas-page-subtitle">Configure examination venues, physical seating capacities, and campus building locations</p>
        </div>
        <div class="ehas-page-actions">
          <button class="ehas-btn ehas-btn-primary" data-bs-toggle="modal" data-bs-target="#hallModal" onclick="resetForm()">
            <i data-lucide="plus-circle"></i>
            <span>Add Venue / Hall</span>
          </button>
        </div>
      </div>

      <!-- Main Card with Table -->
      <div class="ehas-card">
        <div class="ehas-card-header">
          <div class="ehas-toolbar w-100 mb-0">
            <div class="ehas-search-input-group">
              <i data-lucide="search"></i>
              <input type="text" id="hallSearch" placeholder="Search halls or campus locations...">
            </div>
            
            <div class="ehas-filter-group">
              <span class="badge bg-light text-dark border p-2" id="hallCountBadge">
                Loading...
              </span>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="ehas-table" id="hallsTable">
            <thead>
              <tr>
                <th>Hall / Venue Name</th>
                <th>Physical Location</th>
                <th>Seating Capacity</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <!-- Loaded dynamically via JS -->
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Add / Edit Hall Modal -->
<div class="modal fade" id="hallModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: var(--ehas-radius-lg); border: 1px solid var(--ehas-border); box-shadow: var(--ehas-shadow-xl);">
      <div class="modal-header border-bottom px-4 py-3">
        <div class="d-flex align-items-center gap-2">
          <div class="ehas-metric-icon success" style="width:36px;height:36px;">
            <i data-lucide="building" style="width:18px;height:18px;"></i>
          </div>
          <h5 class="modal-title fw-bold" id="modalTitle">Add Examination Hall</h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <div class="modal-body px-4 py-3">
        <div id="modalError" class="ehas-alert ehas-alert-error" style="display:none;"></div>
        
        <form id="hallForm">
          <input type="hidden" id="hall_id">
          
          <div class="ehas-form-group">
            <label class="ehas-label" for="hall_name">Hall Name / Identifier</label>
            <input type="text" id="hall_name" class="ehas-input" placeholder="e.g. Exam Hall A" required>
          </div>
          
          <div class="ehas-form-group">
            <label class="ehas-label" for="capacity">Maximum Seating Capacity (Desks)</label>
            <input type="number" id="capacity" class="ehas-input" placeholder="e.g. 150" min="1" required>
          </div>
          
          <div class="ehas-form-group">
            <label class="ehas-label" for="location">Campus Location / Building</label>
            <input type="text" id="location" class="ehas-input" placeholder="e.g. Main Campus Block A">
          </div>
        </form>
      </div>

      <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: var(--ehas-radius-lg); border-bottom-right-radius: var(--ehas-radius-lg);">
        <button type="button" class="ehas-btn ehas-btn-outline" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="ehas-btn ehas-btn-primary" id="saveBtn" onclick="saveHall()">Save Venue</button>
      </div>
    </div>
  </div>
</div>

<script>
  let modalInstance = null;
  let allHalls = [];

  document.addEventListener('DOMContentLoaded', () => {
    modalInstance = new bootstrap.Modal(document.getElementById('hallModal'));
    loadHalls();

    document.getElementById('hallSearch').addEventListener('input', filterHallsTable);
  });

  async function loadHalls() {
    try {
      const res = await fetch('/api/halls');
      const data = await res.json();
      if (data.success) {
        allHalls = data.data;
        renderHalls(allHalls);
      }
    } catch (e) {
      console.error(e);
      alert('Failed to load halls.');
    }
  }

  function renderHalls(halls) {
    const tbody = document.querySelector('#hallsTable tbody');
    tbody.innerHTML = '';
    
    const totalCap = halls.reduce((sum, h) => sum + h.capacity, 0);
    document.getElementById('hallCountBadge').innerText = `${halls.length} Halls (${totalCap} Total Seats)`;

    if (halls.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No examination halls registered.</td></tr>';
      return;
    }

    halls.forEach(h => {
      tbody.innerHTML += `
        <tr>
          <td>
            <div class="d-flex align-items-center gap-3">
              <div class="ehas-metric-icon success" style="width:34px;height:34px;">
                <i data-lucide="building" style="width:16px;height:16px;"></i>
              </div>
              <strong class="text-dark">${h.hall_name}</strong>
            </div>
          </td>
          <td>
            <span class="text-muted"><i data-lucide="map-pin" style="width:13px;height:13px;display:inline;"></i> ${h.location || 'Main Faculty Campus'}</span>
          </td>
          <td>
            <strong style="color:var(--ehas-primary); font-size:1.05rem;">${h.capacity}</strong> <span class="text-muted" style="font-size:0.8rem;">Seats</span>
          </td>
          <td>
            <span class="ehas-badge ehas-badge-allocated">Active & Configured</span>
          </td>
          <td class="text-end">
            <button class="ehas-btn ehas-btn-outline ehas-btn-sm me-1" onclick='editHall(${JSON.stringify(h)})' title="Edit">
              <i data-lucide="edit-3" style="width:14px;height:14px;"></i>
            </button>
            <button class="ehas-btn ehas-btn-outline text-danger ehas-btn-sm" onclick="deleteHall(${h.hall_id})" title="Delete">
              <i data-lucide="trash-2" style="width:14px;height:14px;"></i>
            </button>
          </td>
        </tr>
      `;
    });

    if (window.lucide) lucide.createIcons();
  }

  function filterHallsTable() {
    const term = document.getElementById('hallSearch').value.toLowerCase().trim();

    const filtered = allHalls.filter(h => {
      return h.hall_name.toLowerCase().includes(term) || 
             (h.location && h.location.toLowerCase().includes(term));
    });

    renderHalls(filtered);
  }

  function resetForm() {
    document.getElementById('hallForm').reset();
    document.getElementById('hall_id').value = '';
    document.getElementById('modalTitle').innerText = 'Add Examination Hall';
    document.getElementById('modalError').style.display = 'none';
  }

  function editHall(h) {
    resetForm();
    document.getElementById('modalTitle').innerText = 'Edit Examination Hall';
    document.getElementById('hall_id').value = h.hall_id;
    document.getElementById('hall_name').value = h.hall_name;
    document.getElementById('capacity').value = h.capacity;
    document.getElementById('location').value = h.location || '';
    modalInstance.show();
  }

  async function saveHall() {
    const errDiv = document.getElementById('modalError');
    errDiv.style.display = 'none';
    
    const id = document.getElementById('hall_id').value;
    const payload = {
      hall_name: document.getElementById('hall_name').value.trim(),
      capacity: parseInt(document.getElementById('capacity').value),
      location: document.getElementById('location').value.trim()
    };

    if (!payload.hall_name || !payload.capacity) {
      errDiv.innerHTML = '<i data-lucide="alert-circle"></i><span>Please provide hall name and seating capacity.</span>';
      errDiv.style.display = 'flex';
      if (window.lucide) lucide.createIcons();
      return;
    }

    const method = id ? 'PUT' : 'POST';
    const url = id ? `/api/halls/${id}` : '/api/halls';

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      
      if (data.success) {
        modalInstance.hide();
        loadHalls();
      } else {
        errDiv.innerHTML = `<i data-lucide="alert-circle"></i><span>${data.error}</span>`;
        errDiv.style.display = 'flex';
        if (window.lucide) lucide.createIcons();
      }
    } catch (e) {
      errDiv.innerHTML = `<i data-lucide="alert-circle"></i><span>Network error.</span>`;
      errDiv.style.display = 'flex';
      if (window.lucide) lucide.createIcons();
    }
  }

  async function deleteHall(id) {
    if (confirm('Are you sure you want to delete this hall? Any assigned allocations using this hall will also be removed.')) {
      try {
        const res = await fetch(`/api/halls/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          loadHalls();
        } else {
          alert(data.error);
        }
      } catch (e) {
        alert('Network error.');
      }
    }
  }
</script>

<%- include('../partials/footer') %>
