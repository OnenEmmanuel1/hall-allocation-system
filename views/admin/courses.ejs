<%- include('../partials/header') %>

<div class="ehas-app">
  <%- include('../partials/sidebar-admin') %>

  <div class="ehas-main-wrapper">
    <%- include('../partials/topbar') %>

    <main class="ehas-content">
      
      <!-- Page Header -->
      <div class="ehas-page-header">
        <div>
          <h1 class="ehas-page-title">Manage Courses</h1>
          <p class="ehas-page-subtitle">Configure faculty courses, credit levels, and student enrollments for examination allocation</p>
        </div>
        <div class="ehas-page-actions">
          <button class="ehas-btn ehas-btn-primary" data-bs-toggle="modal" data-bs-target="#courseModal" onclick="resetForm()">
            <i data-lucide="plus-circle"></i>
            <span>Add Course</span>
          </button>
        </div>
      </div>

      <!-- Main Card with Filter Toolbar & Table -->
      <div class="ehas-card">
        <div class="ehas-card-header">
          <div class="ehas-toolbar w-100 mb-0">
            <div class="ehas-search-input-group">
              <i data-lucide="search"></i>
              <input type="text" id="courseSearch" placeholder="Search by course code, title, or department...">
            </div>
            
            <div class="ehas-filter-group">
              <select id="levelFilter" class="form-select form-select-sm" style="width: auto; min-width: 140px; border-radius: var(--ehas-radius);">
                <option value="">All Levels</option>
                <option value="100">100 Level</option>
                <option value="200">200 Level</option>
                <option value="300">300 Level</option>
                <option value="400">400 Level</option>
                <option value="500">500 Level</option>
              </select>

              <span class="badge bg-light text-dark border p-2" id="courseCountBadge">
                Loading...
              </span>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="ehas-table" id="coursesTable">
            <thead>
              <tr>
                <th>Course Code</th>
                <th>Course Title</th>
                <th>Department</th>
                <th>Level</th>
                <th>Enrolled Candidates</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <!-- Loaded dynamically via JS -->
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Add / Edit Course Modal -->
<div class="modal fade" id="courseModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: var(--ehas-radius-lg); border: 1px solid var(--ehas-border); box-shadow: var(--ehas-shadow-xl);">
      <div class="modal-header border-bottom px-4 py-3">
        <div class="d-flex align-items-center gap-2">
          <div class="ehas-metric-icon warning" style="width:36px;height:36px;">
            <i data-lucide="book-open" style="width:18px;height:18px;"></i>
          </div>
          <h5 class="modal-title fw-bold" id="modalTitle">Add New Course</h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <div class="modal-body px-4 py-3">
        <div id="modalError" class="ehas-alert ehas-alert-error" style="display:none;"></div>
        
        <form id="courseForm">
          <input type="hidden" id="course_id">
          
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="ehas-label" for="course_code">Course Code</label>
              <input type="text" id="course_code" class="ehas-input text-uppercase" placeholder="e.g. CMP101" required>
            </div>
            <div class="col-md-6">
              <label class="ehas-label" for="level">Academic Level</label>
              <select id="level" class="ehas-input" required>
                <option value="100">100 Level</option>
                <option value="200">200 Level</option>
                <option value="300">300 Level</option>
                <option value="400">400 Level</option>
                <option value="500">500 Level</option>
              </select>
            </div>
          </div>
          
          <div class="ehas-form-group">
            <label class="ehas-label" for="course_title">Course Title</label>
            <input type="text" id="course_title" class="ehas-input" placeholder="e.g. Introduction to Computer Science" required>
          </div>
          
          <div class="ehas-form-group">
            <label class="ehas-label" for="department">Department</label>
            <input type="text" id="department" class="ehas-input" required value="Computer Science">
          </div>
        </form>
      </div>

      <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: var(--ehas-radius-lg); border-bottom-right-radius: var(--ehas-radius-lg);">
        <button type="button" class="ehas-btn ehas-btn-outline" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="ehas-btn ehas-btn-primary" id="saveBtn" onclick="saveCourse()">Save Course</button>
      </div>
    </div>
  </div>
</div>

<!-- Enroll Students Modal -->
<div class="modal fade" id="enrollModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content" style="border-radius: var(--ehas-radius-lg); border: 1px solid var(--ehas-border); box-shadow: var(--ehas-shadow-xl);">
      <div class="modal-header border-bottom px-4 py-3">
        <div>
          <h5 class="modal-title fw-bold">Enroll Students: <span id="enrollCourseCode" class="text-primary"></span></h5>
          <div class="text-muted" style="font-size:0.8125rem;">Checked students are enrolled. Uncheck a student to remove them from the course.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body px-4 py-3">
        <div id="enrollError" class="ehas-alert ehas-alert-error" style="display:none;"></div>
        <input type="hidden" id="enroll_course_id">
        
        <div class="ehas-search-input-group w-100 mb-3" style="max-width:100%;">
          <i data-lucide="search"></i>
          <input type="text" id="enrollStudentSearch" placeholder="Filter candidates by name or matric number...">
        </div>

        <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--ehas-border); border-radius: var(--ehas-radius);">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light sticky-top">
              <tr>
                <th width="50" class="text-center">Select</th>
                <th>Student Full Name</th>
                <th>Matriculation No</th>
              </tr>
            </thead>
            <tbody id="studentListBody">
              <% if (students && students.length) { %>
                <% students.forEach(s => { %>
                  <tr class="student-enroll-row" data-name="<%= s.full_name.toLowerCase() %>" data-matric="<%= s.matric_no.toLowerCase() %>">
                    <td class="text-center">
                      <input type="checkbox" class="form-check-input student-check" value="<%= s.student_id %>" style="cursor:pointer;">
                    </td>
                    <td><strong class="text-dark"><%= s.full_name %></strong></td>
                    <td><code><%= s.matric_no %></code></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="text-center py-4 text-muted">No students available in directory.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="modal-footer border-top px-4 py-3 bg-light" style="border-bottom-left-radius: var(--ehas-radius-lg); border-bottom-right-radius: var(--ehas-radius-lg);">
        <button type="button" class="ehas-btn ehas-btn-outline" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="ehas-btn ehas-btn-primary" onclick="submitEnroll()">
          <i data-lucide="user-check"></i>
          <span>Save Course Roster</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let courseModal = null;
  let enrollModal = null;
  let allCourses = [];

  document.addEventListener('DOMContentLoaded', () => {
    courseModal = new bootstrap.Modal(document.getElementById('courseModal'));
    enrollModal = new bootstrap.Modal(document.getElementById('enrollModal'));
    loadCourses();

    document.getElementById('courseSearch').addEventListener('input', filterCoursesTable);
    document.getElementById('levelFilter').addEventListener('change', filterCoursesTable);

    document.getElementById('enrollStudentSearch').addEventListener('input', function(e) {
      const term = e.target.value.toLowerCase().trim();
      document.querySelectorAll('.student-enroll-row').forEach(row => {
        const name = row.dataset.name;
        const matric = row.dataset.matric;
        if (name.includes(term) || matric.includes(term)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });

  async function loadCourses() {
    try {
      const res = await fetch('/api/courses');
      const data = await res.json();
      if (data.success) {
        allCourses = data.data;
        renderCourses(allCourses);
      }
    } catch (e) {
      console.error(e);
      alert('Failed to load courses.');
    }
  }

  function renderCourses(courses) {
    const tbody = document.querySelector('#coursesTable tbody');
    tbody.innerHTML = '';
    
    document.getElementById('courseCountBadge').innerText = `${courses.length} Courses`;

    if (courses.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">No matching courses found.</td></tr>';
      return;
    }

    courses.forEach(c => {
      tbody.innerHTML += `
        <tr>
          <td><strong style="color:var(--ehas-primary); font-size:0.95rem;">${c.course_code}</strong></td>
          <td><span class="fw-semibold text-dark">${c.course_title}</span></td>
          <td>${c.department}</td>
          <td><span class="ehas-badge ehas-badge-neutral">Level ${c.level}</span></td>
          <td>
            <span class="badge ${c.enrolled_count > 0 ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-light text-muted border'} px-2 py-1">
              <i data-lucide="users" style="width:13px;height:13px;display:inline;"></i>
              <strong>${c.enrolled_count}</strong> Enrolled
            </span>
          </td>
          <td class="text-end">
            <button class="ehas-btn ehas-btn-outline ehas-btn-sm me-1" onclick="openEnroll(${c.course_id}, '${c.course_code}')" title="Enroll Students">
              <i data-lucide="user-plus" style="width:14px;height:14px;"></i>
              <span>Enroll</span>
            </button>
            <button class="ehas-btn ehas-btn-outline ehas-btn-sm me-1" onclick='editCourse(${JSON.stringify(c)})' title="Edit">
              <i data-lucide="edit-3" style="width:14px;height:14px;"></i>
            </button>
            <button class="ehas-btn ehas-btn-outline text-danger ehas-btn-sm" onclick="deleteCourse(${c.course_id})" title="Delete">
              <i data-lucide="trash-2" style="width:14px;height:14px;"></i>
            </button>
          </td>
        </tr>
      `;
    });

    if (window.lucide) lucide.createIcons();
  }

  function filterCoursesTable() {
    const term = document.getElementById('courseSearch').value.toLowerCase().trim();
    const level = document.getElementById('levelFilter').value;

    const filtered = allCourses.filter(c => {
      const matchSearch = c.course_code.toLowerCase().includes(term) || 
                          c.course_title.toLowerCase().includes(term) || 
                          c.department.toLowerCase().includes(term);
      const matchLevel = !level || c.level.toString() === level;
      return matchSearch && matchLevel;
    });

    renderCourses(filtered);
  }

  function resetForm() {
    document.getElementById('courseForm').reset();
    document.getElementById('course_id').value = '';
    document.getElementById('modalTitle').innerText = 'Add New Course';
    document.getElementById('modalError').style.display = 'none';
  }

  function editCourse(c) {
    resetForm();
    document.getElementById('modalTitle').innerText = 'Edit Course Record';
    document.getElementById('course_id').value = c.course_id;
    document.getElementById('course_code').value = c.course_code;
    document.getElementById('course_title').value = c.course_title;
    document.getElementById('department').value = c.department;
    document.getElementById('level').value = c.level;
    courseModal.show();
  }

  async function saveCourse() {
    const errDiv = document.getElementById('modalError');
    errDiv.style.display = 'none';
    
    const id = document.getElementById('course_id').value;
    const payload = {
      course_code: document.getElementById('course_code').value.trim().toUpperCase(),
      course_title: document.getElementById('course_title').value.trim(),
      department: document.getElementById('department').value.trim(),
      level: document.getElementById('level').value
    };

    if (!payload.course_code || !payload.course_title) {
      errDiv.innerHTML = '<i data-lucide="alert-circle"></i><span>Please provide course code and course title.</span>';
      errDiv.style.display = 'flex';
      if (window.lucide) lucide.createIcons();
      return;
    }

    const method = id ? 'PUT' : 'POST';
    const url = id ? `/api/courses/${id}` : '/api/courses';

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      
      if (data.success) {
        courseModal.hide();
        loadCourses();
      } else {
        errDiv.innerHTML = `<i data-lucide="alert-circle"></i><span>${data.error}</span>`;
        errDiv.style.display = 'flex';
        if (window.lucide) lucide.createIcons();
      }
    } catch (e) {
      errDiv.innerHTML = `<i data-lucide="alert-circle"></i><span>Network error.</span>`;
      errDiv.style.display = 'flex';
      if (window.lucide) lucide.createIcons();
    }
  }

  async function deleteCourse(id) {
    if (confirm('Are you sure you want to delete this course? Associated enrollments will be deleted.')) {
      try {
        const res = await fetch(`/api/courses/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          loadCourses();
        } else {
          alert(data.error);
        }
      } catch (e) {
        alert('Network error.');
      }
    }
  }

  async function openEnroll(courseId, courseCode) {
    document.getElementById('enroll_course_id').value = courseId;
    document.getElementById('enrollCourseCode').innerText = courseCode;
    document.getElementById('enrollError').style.display = 'none';
    document.getElementById('enrollStudentSearch').value = '';
    
    document.querySelectorAll('.student-check').forEach(cb => cb.checked = false);
    document.querySelectorAll('.student-enroll-row').forEach(r => r.style.display = '');
    enrollModal.show();
    try {
      const res = await fetch(`/api/courses/${courseId}/enroll`);
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Could not load current enrollments.');
      const enrolled = new Set(data.studentIds.map(Number));
      document.querySelectorAll('.student-check').forEach(cb => cb.checked = enrolled.has(Number(cb.value)));
    } catch (e) {
      const errDiv = document.getElementById('enrollError');
      errDiv.textContent = e.message || 'Could not load current enrollments.';
      errDiv.style.display = 'flex';
    }
  }

  async function submitEnroll() {
    const errDiv = document.getElementById('enrollError');
    errDiv.style.display = 'none';
    
    const courseId = document.getElementById('enroll_course_id').value;
    const checked = document.querySelectorAll('.student-check:checked');
    const studentIds = Array.from(checked).map(cb => parseInt(cb.value));
    
    try {
      const res = await fetch(`/api/courses/${courseId}/enroll`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentIds })
      });
      const data = await res.json();
      
      if (data.success) {
        enrollModal.hide();
        loadCourses();
      } else {
        errDiv.innerHTML = `<i data-lucide="alert-circle"></i><span>${data.error}</span>`;
        errDiv.style.display = 'flex';
        if (window.lucide) lucide.createIcons();
      }
    } catch (e) {
      errDiv.innerHTML = `<i data-lucide="alert-circle"></i><span>Network error.</span>`;
      errDiv.style.display = 'flex';
      if (window.lucide) lucide.createIcons();
    }
  }
</script>

<%- include('../partials/footer') %>
