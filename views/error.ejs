<%- include('partials/header') %>

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light p-4">
  <div class="ehas-card text-center p-5 shadow-lg" style="max-width: 500px; width: 100%;">
    <div class="ehas-metric-icon error mx-auto mb-3" style="width:64px;height:64px;background-color:var(--ehas-error-light);color:var(--ehas-error);">
      <i data-lucide="alert-triangle" style="width:32px;height:32px;"></i>
    </div>
    <h2 class="fw-bold mb-2"><%= typeof title !== 'undefined' ? title : 'Error' %></h2>
    <p class="text-muted mb-4">
      <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %>
    </p>
    <a href="/" class="ehas-btn ehas-btn-primary">
      <i data-lucide="home"></i>
      <span>Return to Dashboard</span>
    </a>
  </div>
</div>

<%- include('partials/footer') %>
